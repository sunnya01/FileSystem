*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZVHR0015........................................*
FORM GET_DATA_ZVHR0015.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZTHR0015 WHERE
(VIM_WHERETAB) .
    CLEAR ZVHR0015 .
ZVHR0015-SHHID =
ZTHR0015-SHHID .
ZVHR0015-ZZHLP =
ZTHR0015-ZZHLP .
ZVHR0015-ZZNAM =
ZTHR0015-ZZNAM .
ZVHR0015-ZZSHP =
ZTHR0015-ZZSHP .
ZVHR0015-ZFKEY =
ZTHR0015-ZFKEY .
ZVHR0015-ZFTXT =
ZTHR0015-ZFTXT .
ZVHR0015-ZCOND =
ZTHR0015-ZCOND .
ZVHR0015-ZDKEY =
ZTHR0015-ZDKEY .
ZVHR0015-ZSORT =
ZTHR0015-ZSORT .
    SELECT SINGLE * FROM ZTHR0015T WHERE
SHHID = ZTHR0015-SHHID AND
LANGU = SY-LANGU .
    IF SY-SUBRC EQ 0.
ZVHR0015-SHHNA =
ZTHR0015T-SHHNA .
    ENDIF.
<VIM_TOTAL_STRUC> = ZVHR0015.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZVHR0015 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZVHR0015.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZVHR0015-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTHR0015 WHERE
  SHHID = ZVHR0015-SHHID .
    IF SY-SUBRC = 0.
    DELETE ZTHR0015 .
    ENDIF.
    DELETE FROM ZTHR0015T WHERE
    SHHID = ZTHR0015-SHHID .
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTHR0015 WHERE
  SHHID = ZVHR0015-SHHID .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZTHR0015.
    ENDIF.
ZTHR0015-SHHID =
ZVHR0015-SHHID .
ZTHR0015-ZZHLP =
ZVHR0015-ZZHLP .
ZTHR0015-ZZNAM =
ZVHR0015-ZZNAM .
ZTHR0015-ZZSHP =
ZVHR0015-ZZSHP .
ZTHR0015-ZFKEY =
ZVHR0015-ZFKEY .
ZTHR0015-ZFTXT =
ZVHR0015-ZFTXT .
ZTHR0015-ZCOND =
ZVHR0015-ZCOND .
ZTHR0015-ZDKEY =
ZVHR0015-ZDKEY .
ZTHR0015-ZSORT =
ZVHR0015-ZSORT .
    IF SY-SUBRC = 0.
    UPDATE ZTHR0015 ##WARN_OK.
    ELSE.
    INSERT ZTHR0015 .
    ENDIF.
    SELECT SINGLE FOR UPDATE * FROM ZTHR0015T WHERE
    SHHID = ZTHR0015-SHHID AND
    LANGU = SY-LANGU .
      IF SY-SUBRC <> 0.   "insert preprocessing: init WA
        CLEAR ZTHR0015T.
ZTHR0015T-SHHID =
ZTHR0015-SHHID .
ZTHR0015T-LANGU =
SY-LANGU .
      ENDIF.
ZTHR0015T-SHHNA =
ZVHR0015-SHHNA .
    IF SY-SUBRC = 0.
    UPDATE ZTHR0015T ##WARN_OK.
    ELSE.
    INSERT ZTHR0015T .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZVHR0015-UPD_FLAG,
STATUS_ZVHR0015-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
