FORM READ_SINGLE_ENTRY_ZVHR0015.
  SELECT SINGLE * FROM ZTHR0015 WHERE
SHHID = ZVHR0015-SHHID .
ZVHR0015-SHHID =
ZTHR0015-SHHID .
ZVHR0015-ZZHLP =
ZTHR0015-ZZHLP .
ZVHR0015-ZZNAM =
ZTHR0015-ZZNAM .
ZVHR0015-ZZSHP =
ZTHR0015-ZZSHP .
ZVHR0015-ZFKEY =
ZTHR0015-ZFKEY .
ZVHR0015-ZFTXT =
ZTHR0015-ZFTXT .
ZVHR0015-ZCOND =
ZTHR0015-ZCOND .
ZVHR0015-ZDKEY =
ZTHR0015-ZDKEY .
ZVHR0015-ZSORT =
ZTHR0015-ZSORT .
    SELECT SINGLE * FROM ZTHR0015T WHERE
SHHID = ZTHR0015-SHHID AND
LANGU = SY-LANGU .
    IF SY-SUBRC EQ 0.
ZVHR0015-SHHNA =
ZTHR0015T-SHHNA .
    ELSE.
      CLEAR SY-SUBRC.
      CLEAR ZVHR0015-SHHNA .
    ENDIF.
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZVHR0015 USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZVHR0015-SHHID TO
ZTHR0015-SHHID .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZTHR0015'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZTHR0015 TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZTHR0015'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

MOVE ZTHR0015-SHHID TO
ZTHR0015T-SHHID .
MOVE SY-LANGU TO
ZTHR0015T-LANGU .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZTHR0015T'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZTHR0015T TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZTHR0015T'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
